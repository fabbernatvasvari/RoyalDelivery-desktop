<Window x:Class="RoyalDelivery.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewmodel="clr-namespace:RoyalDelivery.ViewModels.Pages"
        xmlns:view="clr-namespace:RoyalDelivery.Views.Pages"
        Title="Royal Delivery™ – Admin"
        Height="800"
        Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="#F5F6FA">
    <Window.Resources>

        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#353B48"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>
    


    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR -->
        <Border Background="#2F3640" Grid.Column="0">
            <DockPanel>

                <!-- Logo -->
                <TextBlock Text="Royal Delivery"
                           Foreground="White"
                           FontSize="20"
                           FontWeight="Bold"
                           Margin="20"
                           DockPanel.Dock="Top"/>

                <!-- Navigation -->
                <StackPanel>

                    <Button 
                            Command="{Binding ShowRestaurantViewCommand}">
                        Éttermek
                    </Button>

                    <Button 
                            Command="{Binding ShowMealViewCommand}">
                        Ételek
                    </Button>

                    <Button 
                            Command="{Binding ShowOrderViewCommand}">
                        Rendelések
                    </Button>

                    <Button 
                            Command="{Binding ShowUserViewCommand}">
                        Felhasználók
                    </Button>

                </StackPanel>

                <!-- Settings bottom -->
                <Button DockPanel.Dock="Bottom"
                        
                        Command="{Binding ShowSettingsCommand}">
                    ⚙ Beállítások
                </Button>

            </DockPanel>
        </Border>

        <!-- MAIN AREA -->
        <Grid Grid.Column="1">

            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Background="White" Padding="20" 
                    BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">

                <DockPanel>
                    <TextBlock Text="{Binding CurrentPageTitle}"
                               FontSize="22"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>

                    <Button DockPanel.Dock="Right"
                            Width="40" Height="40"
                            Command="{Binding ShowHomeCommand}">
                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                   Text="&#xE80F;"
                                   FontSize="18"/>
                    </Button>
                </DockPanel>

            </Border>

            <!-- Content -->
            <ContentControl Grid.Row="1"
                            Content="{Binding CurrentView}"
                            Margin="20"/>

        </Grid>
    </Grid>
</Window>