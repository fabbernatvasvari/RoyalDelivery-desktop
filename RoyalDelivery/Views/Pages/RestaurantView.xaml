<UserControl x:Class="RoyalDelivery.Views.Pages.RestaurantView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:viewmodels="clr-namespace:RoyalDelivery.ViewModels.Pages"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:pages="clr-namespace:RoyalDelivery.ViewModels.Pages"   
             d:DataContext="{d:DesignInstance Type=viewmodels:RestaurantViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             Background="#F5F6FA"
             >

    <Grid>
        <Border Style="{StaticResource PageCardStyle}">
            <StackPanel Margin="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <StackPanel Grid.Row="0">
                        <TextBlock Text="Éttermek" Style="{StaticResource PageTitleStyle}"/>
                        <TextBlock Text="A rendszerben szereplő éttermek listája."
                               Style="{StaticResource PageSubtitleStyle}"/>
                    </StackPanel>

                    <!-- Table area -->
                    <Grid Grid.Row="2">
                        <DataGrid ItemsSource="{Binding Restaurants}"
                              SelectedItem="{Binding SelectedRestaurant, Mode=TwoWay}"
                              Style="{StaticResource ModernDataGridStyle}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Azonosító" Binding="{Binding Id}" Width="120"/>
                                <DataGridTextColumn Header="Név" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="Tulajdonos ID" Binding="{Binding Ownerid}" Width="160"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Empty state -->
                        <Border Background="#CCFFFFFF"
                            CornerRadius="12"
                            Padding="20"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Restaurants.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="🍽"
                                       FontSize="34"
                                       HorizontalAlignment="Center"/>
                                <TextBlock Text="Nincs megjeleníthető étterem."
                                       Margin="0,8,0,0"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"/>
                                <TextBlock Text="Ha kerül be adat, itt fog megjelenni."
                                       Margin="0,4,0,0"
                                       Opacity="0.7"
                                       HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <TextBlock Text="Éttermek listája" FontSize="24" FontWeight="Bold" Margin="0,0,0,10"/>

                        <DataGrid ItemsSource="{Binding Restaurants}"
                                  SelectedItem="{Binding SelectedUser, Mode=TwoWay}"
                                  Style="{StaticResource ModernDataGridStyle}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Azonosító" Binding="{Binding Id}" />
                                <DataGridTextColumn Header="Név" Binding="{Binding Name}" />
                                <DataGridTextColumn Header="Tulajdonos ID" Binding="{Binding Ownerid}" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <ListView ItemsSource="{Binding Restaurants}" Height="300" SelectedItem="{Binding SelectedRestaurant, Mode=TwoWay}">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Id" DisplayMemberBinding="{Binding Id}" />
                                    <GridViewColumn Header="Felhasználónév" DisplayMemberBinding="{Binding Name}" />
                                    <GridViewColumn Header="Keresztnév" DisplayMemberBinding="{Binding Address}" />
                                    <GridViewColumn Header="Vezetéknév" DisplayMemberBinding="{Binding Menu}" />
                                </GridView>
                            </ListView.View>
                            <ListView.Style>
                                <Style TargetType="ListView">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Restaurants.Count}" Value="0">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListView">
                                                        <Grid>
                                                            <TextBlock Text="Nincs megjeleníthető adat🥀."
       HorizontalAlignment="Center"
       VerticalAlignment="Center"
       Opacity="0.6"/>
                                                        </Grid>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListView.Style>
                        </ListView>
                    </Grid>
                <Button Content="Törlés"
                    Command="{Binding DeleteSelectedCommand}"
                    Margin="0,10,0,0" />

                <!-- Footer -->
                <DockPanel Grid.Row="4">
                    <TextBlock Text="{Binding Restaurants.Count, StringFormat=Összesen: {0} étterem}"
                               VerticalAlignment="Center"
                               Foreground="#6B7280"/>


                </DockPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
